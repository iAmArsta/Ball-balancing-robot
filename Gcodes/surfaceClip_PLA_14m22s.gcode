; thumbnail end
; THUMBNAIL_BLOCK_END

; external perimeters extrusion width = 0.42mm
; perimeters extrusion width = 0.45mm
; infill extrusion width = 0.45mm
; solid infill extrusion width = 0.45mm
; top infill extrusion width = 0.42mm
; support material extrusion width = 0.42mm
; first layer extrusion width = 0.50mm

; EXECUTABLE_BLOCK_START
EXCLUDE_OBJECT_DEFINE NAME=surfaceClip.STL_id_0_copy_0 CENTER=110,110 POLYGON=[[102.5,104],[105.5,100],[114.5,100],[117.5,104],[117.5,116],[114.5,120],[105.5,120],[102.5,116],[102.5,104]]
M73 P0 R14
;TYPE:Custom
SET_GCODE_VARIABLE MACRO=PRINTER_PARAM VARIABLE=fan0_min VALUE=30 ;compensate for fan speed
SET_VELOCITY_LIMIT ACCEL_TO_DECEL=2500 ;revert accel_to_decel back to 2500
M220 S100 ;Reset Feedrate
M221 S100 ;Reset Flowrate

M140 S55 ;Set bed temp
G28 X Y ;Home XY axes
M190 S55 ;Wait for bed temp to stabilize
G28 Z ;Home Z axis & load bed mesh
BED_MESH_CALIBRATE PROBE_COUNT=5,5 ;Auto bed level

M104 S220 ;Set nozzle temp
G92 E0 ;Reset Extruder
G1 X-2.0 Y20 Z0.3 F5000.0 ;Move to start position
M109 S220 ;Wait for nozzle temp to stabilize
G1 Z0.2 ;Lower nozzle to printing height
G1 Y145.0 F1500.0 E15 ;Draw the first line
G1 X-1.7 F5000.0 ;Move to side a little
G1 Y30 F1500.0 E15 ;Draw the second line
G92 E0 ;Reset Extruder
G90
G21
M83 ; use relative distances for extrusion
; Filament gcode
M106 S0
;LAYER_CHANGE
;Z:0.2
;HEIGHT:0.2
;BEFORE_LAYER_CHANGE
;0.2
G92 E0

G1 E-.5 F1800
M73 P1 R14
;_SET_FAN_SPEED_CHANGING_LAYER
SET_VELOCITY_LIMIT ACCEL=1000
SET_VELOCITY_LIMIT SQUARE_CORNER_VELOCITY=7
G1 Z1.2 F18000
G1 X99.231 Y97.234
G1 Z1.2
G1 Z.2
G1 E.5 F1800
